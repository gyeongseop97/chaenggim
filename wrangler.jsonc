{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaenggim-weather",
  "main": "backend/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app-config.js"]
  },
  // Push notifications are optional. Create your own D1 database, then
  // uncomment this property and insert the ID returned by Cloudflare.
  // "d1_databases": [{
  //   "binding": "WEATHER_DB",
  //   "database_name": "chaenggim-notifications",
  //   "database_id": "REPLACE_WITH_THE_DATABASE_ID_FROM_CLOUDFLARE",
  //   "migrations_dir": "backend/migrations"
  // }],
  "vars": {
    "PUSH_SCHEDULER_READY": "false"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
