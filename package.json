{
  "name": "chaenggim-weather",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "챙김 — 실제 날씨와 옷차림을 알려주는 설치형 웹앱",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "worker:dev": "npm run build && wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "push:keys": "node scripts/generate-push-keys.mjs"
  },
  "devDependencies": {"wrangler": "4.151.0"}
}
